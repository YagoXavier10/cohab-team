rules_version = '2';

// Regras do ranking dos jogos (Firebase > Firestore Database > Regras).
// Todo mundo pode ler o ranking. Cada aparelho tem um login anônimo e só pode
// criar ou melhorar a própria pontuação; ninguém mexe na dos outros (só o admin apaga, para moderar).
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin do Tatame Online (painel admin.html): cole aqui o UID do usuário admin (Authentication → Users).
    function isAdmin() {
      return request.auth != null && request.auth.uid in ['COLE_SEU_UID_AQUI'];
    }

    // Configuração do Tatame Online (jogos ligados, destaque, aviso...): todo mundo lê, só o admin grava.
    match /site/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Nickname: 3 a 16 letras, números, espaço, ponto, _ ou -, sem palavrão (a mesma lista do ranking.js).
    // O site já confere isso; aqui vale também para quem tenta gravar direto no banco.
    function nickOk(n) {
      let edge = 'porra|merda|puta|viado|fdp|pqp|bosta|corno|nazi|admin|oficial';
      let l = n.lower();
      return n is string && n.matches('[\\p{L}\\p{N} _.-]{3,16}')
        && !l.matches('.*(caralh|bucet|arrombad|vagabund|desgraca|xoxota|punheta|siririca|piroca|cuzao|hitler|cohabteam).*')
        && !l.matches('(.*[^\\p{L}\\p{N}])?(' + edge + ').*')
        && !l.matches('.*(' + edge + ')([^\\p{L}\\p{N}].*)?');
    }

    match /ranking/{game}/scores/{uid} {
      function maxScore() {
        return {
          'posicoes-relogio': 60000,
          'posicoes-morte': 60000,
          'regras': 6000,
          'arbitro': 15,
          'caminho': 21,
          'quiz': 40,
          'luta': 10000,
          'torre': 2000,
          'esquiva': 1000000,
          'palavras': 10000,
          'pares': 20000,
          'deslize': 10000,
          'labirinto': 5000,
          'alvo': 20000,
          'cartas': 10000
        }.get(game, -1);
      }

      function valid() {
        let d = request.resource.data;
        return d.keys().hasOnly(['nick', 'score', 'updated'])
          && nickOk(d.nick)
          && d.score is int && d.score > 0 && d.score <= maxScore()
          && d.updated == request.time;
      }

      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid && valid();
      allow update: if request.auth != null && request.auth.uid == uid && valid()
        && request.resource.data.score >= resource.data.score;
      // só o admin apaga (moderação no painel)
      allow delete: if isAdmin();
    }

    // Luta ao vivo: salas com código de 4 dígitos que valem por 1 hora.
    // Azul cria, Branco entra; só os dois lutadores mexem na sala e cada um só responde por si.
    match /salas/{codigo} {
      function sala() { return resource.data; }
      function nova() { return request.resource.data; }
      function mudou() { return nova().diff(sala()).affectedKeys(); }
      function lutador() { return request.auth.uid == sala().azul || request.auth.uid == sala().branco; }
      function vence() { return sala().criada + duration.value(1, 'h'); }

      // cada pergunta é do banco oficial, nunca texto livre:
      // jiu-jitsu = "faixa:número:ordem"; outros temas = "tema:nível:número:ordem" (nível f, m ou d)
      function temaOk(t) { return t in ['jiujitsu', 'judo', 'futebol', 'brasil', 'ciencia', 'mundo', 'olimpiadas', 'animais', 'matematica', 'comidas', 'saopaulo', 'mix']; }
      function temaRe(t) {
        return {
          'judo': 'judo', 'futebol': 'futebol', 'brasil': 'brasil', 'ciencia': 'ciencia', 'mundo': 'mundo', 'olimpiadas': 'olimpiadas',
          'animais': 'animais', 'matematica': 'matematica', 'comidas': 'comidas', 'saopaulo': 'saopaulo',
          'mix': '(judo|futebol|brasil|ciencia|mundo|olimpiadas|animais|matematica|comidas|saopaulo)'
        }.get(t, '@');
      }
      function pq(p, i, faixas, nivel, t) {
        return p[i] is string
          && ((t in ['jiujitsu', 'mix'] && p[i].matches('(' + faixas + '):[0-9]{1,2}:[0-3]{4}'))
            || p[i].matches(temaRe(t) + ':' + nivel + ':[0-9]{1,2}:[0-3]{4}'));
      }
      function perguntasOk(p, t) {
        return p is list && p.size() == 10
          && pq(p, 0, 'branca|azul', 'f', t) && pq(p, 1, 'branca|azul', 'f', t) && pq(p, 2, 'branca|azul', 'f', t) && pq(p, 3, 'branca|azul', 'f', t)
          && pq(p, 4, 'roxa|marrom', 'm', t) && pq(p, 5, 'roxa|marrom', 'm', t) && pq(p, 6, 'roxa|marrom', 'm', t)
          && pq(p, 7, 'preta', 'd', t) && pq(p, 8, 'preta', 'd', t) && pq(p, 9, 'preta', 'd', t);
      }

      function criar() {
        return codigo.matches('[0-9]{4}')
          && nova().keys().hasOnly(['azul', 'branco', 'nickAzul', 'nickBranco', 'status', 'tema', 'perguntas', 'rodada',
            'inicio', 'criada', 'vistoAzul', 'vistoBranco', 'vencedor', 'motivo', 'revanche'])
          && temaOk(nova().get('tema', 'jiujitsu'))
          && nova().azul == request.auth.uid && nickOk(nova().nickAzul)
          && nova().branco == null && nova().nickBranco == null
          && nova().status == 'espera' && nova().rodada == 0
          && perguntasOk(nova().perguntas, nova().get('tema', 'jiujitsu'))
          && nova().criada == request.time && nova().inicio == request.time
          && nova().vistoAzul == request.time && nova().vistoBranco == null
          && nova().vencedor == null && nova().motivo == null && nova().revanche == null;
      }
      // Branco entra na sala ("pronto")...
      function entrar() {
        return sala().status == 'espera' && sala().branco == null && request.auth.uid != sala().azul
          && mudou().hasOnly(['branco', 'nickBranco', 'status', 'inicio', 'vistoBranco'])
          && nova().branco == request.auth.uid && nickOk(nova().nickBranco)
          && nova().status == 'pronto' && nova().inicio == request.time && nova().vistoBranco == request.time;
      }
      // ...e a luta só começa quando o Azul, que criou a sala, está com a página aberta
      function comecar() {
        return request.auth.uid == sala().azul && sala().status == 'pronto'
          && mudou().hasOnly(['status', 'inicio', 'vistoAzul'])
          && nova().status == 'luta' && nova().inicio == request.time && nova().vistoAzul == request.time;
      }
      // próxima pergunta (uma de cada vez e nunca antes de 3 segundos)
      function avancar() {
        return lutador() && sala().status == 'luta'
          && mudou().hasOnly(['rodada', 'inicio'])
          && nova().rodada == sala().rodada + 1 && nova().rodada < 10
          && request.time > sala().inicio + duration.value(3, 's')
          && nova().inicio == request.time;
      }
      // "ainda estou aqui": serve para dar W.O. em quem sumiu
      function visto() {
        return (request.auth.uid == sala().azul && mudou().hasOnly(['vistoAzul']) && nova().vistoAzul == request.time)
          || (request.auth.uid == sala().branco && mudou().hasOnly(['vistoBranco']) && nova().vistoBranco == request.time);
      }
      // W.O. só vale se quem pede está desistindo ou se o outro está mesmo sem sinal há 40 s
      function woOk() {
        return (request.auth.uid == sala().azul && (nova().vencedor == 'branco'
            || (nova().vencedor == 'azul' && request.time > sala().vistoBranco + duration.value(40, 's'))))
          || (request.auth.uid == sala().branco && (nova().vencedor == 'azul'
            || (nova().vencedor == 'branco' && request.time > sala().vistoAzul + duration.value(40, 's'))));
      }
      // fora o W.O., a luta só acaba na última pergunta ou por finalização
      // (o vencedor que aparece na tela é calculado pelas respostas em cada celular)
      function terminar() {
        return lutador() && sala().status == 'luta'
          && mudou().hasOnly(['status', 'vencedor', 'motivo'])
          && nova().status == 'fim'
          && nova().vencedor in ['azul', 'branco', 'empate']
          && nova().motivo in ['pontos', 'finalizacao', 'vantagens', 'punicoes', 'empate', 'wo']
          && ((nova().motivo == 'wo' && woOk())
            || (nova().motivo != 'wo' && (sala().rodada == 9 || nova().motivo == 'finalizacao')));
      }
      function revanche() {
        return lutador() && sala().status == 'fim' && sala().revanche == null
          && mudou().hasOnly(['revanche'])
          && nova().revanche is string && nova().revanche.matches('[0-9]{4}');
      }

      allow get: if true;
      // listar só serve para achar salas vencidas e apagar
      allow list: if request.query.limit <= 10 && resource.data.criada < request.time - duration.value(1, 'h');
      allow create: if request.auth != null && criar();
      allow update: if request.auth != null && request.time < vence() && nova().criada == sala().criada
        && (entrar() || comecar() || avancar() || visto() || terminar() || revanche());
      // sala vencida qualquer um apaga; sala esperando adversário quem criou pode cancelar
      allow delete: if request.auth != null
        && (request.time > vence() || (request.auth.uid == sala().azul && sala().status == 'espera'));

      // uma resposta por lutador em cada pergunta, com a hora do servidor (quem acertou primeiro)
      match /jogadas/{jogada} {
        function s() { return get(/databases/$(database)/documents/salas/$(codigo)).data; }
        function venceu() { return request.time > s().criada + duration.value(1, 'h'); }

        allow read: if true;
        allow create: if request.auth != null && s().status == 'luta' && !venceu()
          && ((request.auth.uid == s().azul && jogada == string(s().rodada) + '-azul')
            || (request.auth.uid == s().branco && jogada == string(s().rodada) + '-branco'))
          && request.resource.data.keys().hasOnly(['rodada', 'escolha', 'em'])
          && request.resource.data.rodada == s().rodada
          && request.resource.data.escolha is int
          && request.resource.data.escolha >= 0 && request.resource.data.escolha <= 3
          && request.resource.data.em == request.time
          && request.time > s().inicio + duration.value(1500, 'ms')
          && request.time < s().inicio + duration.value(27, 's');
        allow delete: if request.auth != null && venceu();
      }
    }

    // Desafios relâmpago (tatame-online): minijogos para 2 a 8 jogadores, sala com código de 4 dígitos e 1 hora de validade.
    // Quem cria é o anfitrião; cada jogador só mexe no próprio cadastro e só envia o próprio resultado.
    match /relampago/{codigo} {
      function sala() { return resource.data; }
      function nova() { return request.resource.data; }
      function mudou() { return nova().diff(sala()).affectedKeys(); }
      function vence() { return sala().criada + duration.value(1, 'h'); }
      function host() { return request.auth.uid == sala().host; }
      function jogador() { return exists(/databases/$(database)/documents/relampago/$(codigo)/jogadores/$(request.auth.uid)); }
      // cada desafio é "tipo:semente"; de 3 a 7 desafios
      function dq(d) { return d is string && d.matches('(reflexo|memoria|conta|contar|mira|cor):[0-9]{1,9}'); }
      function desafiosOk(l) {
        return l is list && l.size() >= 3 && l.size() <= 7
          && dq(l[0]) && dq(l[1]) && dq(l[2])
          && (l.size() < 4 || dq(l[3])) && (l.size() < 5 || dq(l[4]))
          && (l.size() < 6 || dq(l[5])) && (l.size() < 7 || dq(l[6]));
      }
      function criar() {
        return codigo.matches('[0-9]{4}')
          && nova().keys().hasOnly(['host', 'status', 'rodada', 'inicio', 'criada', 'desafios', 'revanche'])
          && nova().host == request.auth.uid && nova().status == 'espera' && nova().rodada == 0
          && nova().inicio == request.time && nova().criada == request.time
          && nova().desafios == [] && nova().revanche == null;
      }
      function comecar() {
        return host() && sala().status == 'espera'
          && mudou().hasOnly(['status', 'desafios', 'rodada', 'inicio'])
          && nova().status == 'jogo' && nova().rodada == 0 && nova().inicio == request.time
          && desafiosOk(nova().desafios);
      }
      // próximo desafio: o anfitrião depois de 5 s; qualquer jogador depois de 60 s (se o anfitrião sumir)
      function podeAvancar() {
        return sala().status == 'jogo'
          && ((host() && request.time > sala().inicio + duration.value(5, 's'))
            || (jogador() && request.time > sala().inicio + duration.value(60, 's')));
      }
      function avancar() {
        return podeAvancar() && mudou().hasOnly(['rodada', 'inicio'])
          && nova().rodada == sala().rodada + 1 && nova().rodada < sala().desafios.size()
          && nova().inicio == request.time;
      }
      function terminar() {
        return podeAvancar() && mudou().hasOnly(['status'])
          && sala().rodada == sala().desafios.size() - 1 && nova().status == 'fim';
      }
      function revanche() {
        return jogador() && sala().status == 'fim' && sala().revanche == null
          && mudou().hasOnly(['revanche']) && nova().revanche is string && nova().revanche.matches('[0-9]{4}');
      }

      allow get: if true;
      allow list: if request.query.limit <= 10 && resource.data.criada < request.time - duration.value(1, 'h');
      allow create: if request.auth != null && criar();
      allow update: if request.auth != null && request.time < vence() && nova().criada == sala().criada
        && nova().host == sala().host && (comecar() || avancar() || terminar() || revanche());
      allow delete: if request.auth != null && (request.time > vence() || (host() && sala().status == 'espera'));

      match /jogadores/{uid} {
        function s() { return get(/databases/$(database)/documents/relampago/$(codigo)).data; }
        function venceu() { return request.time > s().criada + duration.value(1, 'h'); }
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == uid && s().status == 'espera' && !venceu()
          && request.resource.data.keys().hasOnly(['nick', 'avatar', 'entrou', 'visto'])
          && nickOk(request.resource.data.nick)
          && request.resource.data.avatar is int && request.resource.data.avatar >= 0 && request.resource.data.avatar <= 15
          && request.resource.data.entrou == request.time && request.resource.data.visto == request.time;
        allow update: if request.auth != null && request.auth.uid == uid && !venceu()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visto'])
          && request.resource.data.visto == request.time;
        // sair da sala (ou o anfitrião fechar a sala) só antes de começar; sala vencida qualquer um limpa
        allow delete: if request.auth != null && (venceu()
          || (s().status == 'espera' && (request.auth.uid == uid || request.auth.uid == s().host)));
      }

      match /resultados/{id} {
        function s() { return get(/databases/$(database)/documents/relampago/$(codigo)).data; }
        allow read: if true;
        allow create: if request.auth != null && s().status == 'jogo'
          && exists(/databases/$(database)/documents/relampago/$(codigo)/jogadores/$(request.auth.uid))
          && id == string(s().rodada) + '-' + request.auth.uid
          && request.resource.data.keys().hasOnly(['rodada', 'valor', 'em'])
          && request.resource.data.rodada == s().rodada
          && request.resource.data.valor is int && request.resource.data.valor >= -2000 && request.resource.data.valor <= 3000000
          && request.resource.data.em == request.time
          && request.time > s().inicio + duration.value(4, 's')
          && request.time < s().inicio + duration.value(50, 's');
        allow delete: if request.auth != null && request.time > s().criada + duration.value(1, 'h');
      }
    }
    // Infiltrado (tatame-online): jogo de palavras para 3 a 8 jogadores. O anfitrião passa as fases
    // (ou qualquer jogador, se o anfitrião sumir por 2 minutos). Cada um só manda a própria dica, voto e chute.
    match /infiltrado/{codigo} {
      function sala() { return resource.data; }
      function nova() { return request.resource.data; }
      function mudou() { return nova().diff(sala()).affectedKeys(); }
      function vence() { return sala().criada + duration.value(1, 'h'); }
      function host() { return request.auth.uid == sala().host; }
      function jogador() { return exists(/databases/$(database)/documents/infiltrado/$(codigo)/jogadores/$(request.auth.uid)); }
      function temaOk(t) { return t in ['Comidas', 'Animais', 'Lugares', 'Profissões', 'Objetos de casa', 'Esportes']; }
      function rodadaOk() {
        return temaOk(nova().tema) && nova().seed is int && nova().ordem is list
          && nova().ordem.size() >= 3 && nova().ordem.size() <= 8 && nova().historico is list && nova().historico.size() <= 8;
      }
      function criar() {
        return codigo.matches('[0-9]{4}')
          && nova().keys().hasOnly(['host', 'status', 'rodada', 'total', 'inicio', 'criada', 'tema', 'seed', 'ordem', 'historico', 'revanche'])
          && nova().host == request.auth.uid && nova().status == 'espera' && nova().rodada == 0 && nova().total == 0
          && nova().inicio == request.time && nova().criada == request.time
          && nova().ordem == [] && nova().historico == [] && nova().revanche == null;
      }
      function comecar() {
        return host() && sala().status == 'espera'
          && mudou().hasOnly(['status', 'total', 'inicio', 'rodada', 'tema', 'seed', 'ordem', 'historico'])
          && nova().status == 'dicas' && nova().rodada == 0 && nova().total in [3, 5, 7]
          && nova().inicio == request.time && rodadaOk();
      }
      // dicas → votação → (chute) → placar → dicas da próxima rodada … → fim
      function fase() {
        return (host() || (jogador() && request.time > sala().inicio + duration.value(120, 's')))
          && request.time > sala().inicio + duration.value(2, 's')
          && nova().inicio == request.time
          && ((sala().status == 'dicas' && nova().status == 'votacao' && mudou().hasOnly(['status', 'inicio']))
            || (sala().status == 'votacao' && nova().status in ['chute', 'placar'] && mudou().hasOnly(['status', 'inicio']))
            || (sala().status == 'chute' && nova().status == 'placar' && mudou().hasOnly(['status', 'inicio']))
            || (sala().status == 'placar' && nova().status == 'fim' && sala().rodada == sala().total - 1 && mudou().hasOnly(['status', 'inicio']))
            || (sala().status == 'placar' && nova().status == 'dicas' && nova().rodada == sala().rodada + 1 && nova().rodada < sala().total
              && mudou().hasOnly(['status', 'inicio', 'rodada', 'tema', 'seed', 'ordem', 'historico']) && rodadaOk()));
      }
      function revanche() {
        return jogador() && sala().status == 'fim' && sala().revanche == null
          && mudou().hasOnly(['revanche']) && nova().revanche is string && nova().revanche.matches('[0-9]{4}');
      }

      allow get: if true;
      allow list: if request.query.limit <= 10 && resource.data.criada < request.time - duration.value(1, 'h');
      allow create: if request.auth != null && criar();
      allow update: if request.auth != null && request.time < vence() && nova().criada == sala().criada
        && nova().host == sala().host && (comecar() || fase() || revanche());
      allow delete: if request.auth != null && (request.time > vence() || (host() && sala().status == 'espera'));

      match /jogadores/{uid} {
        function s() { return get(/databases/$(database)/documents/infiltrado/$(codigo)).data; }
        function venceu() { return request.time > s().criada + duration.value(1, 'h'); }
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == uid && s().status == 'espera' && !venceu()
          && request.resource.data.keys().hasOnly(['nick', 'avatar', 'entrou', 'visto'])
          && nickOk(request.resource.data.nick)
          && request.resource.data.avatar is int && request.resource.data.avatar >= 0 && request.resource.data.avatar <= 15
          && request.resource.data.entrou == request.time && request.resource.data.visto == request.time;
        allow update: if request.auth != null && request.auth.uid == uid && !venceu()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visto'])
          && request.resource.data.visto == request.time;
        allow delete: if request.auth != null && (venceu()
          || (s().status == 'espera' && (request.auth.uid == uid || request.auth.uid == s().host)));
      }

      // dica: uma palavra (2 a 20 letras), sem palavrão, na fase de dicas; id = rodada-volta-uid
      match /dicas/{id} {
        function s() { return get(/databases/$(database)/documents/infiltrado/$(codigo)).data; }
        function d() { return request.resource.data; }
        allow read: if true;
        allow create: if request.auth != null && s().status == 'dicas'
          && request.auth.uid in s().ordem
          && d().keys().hasOnly(['rodada', 'volta', 'texto', 'em'])
          && d().rodada == s().rodada && d().volta in [0, 1]
          && id == string(s().rodada) + '-' + string(d().volta) + '-' + request.auth.uid
          && d().texto is string && d().texto.matches('[\\p{L}\\p{N} -]{2,20}')
          && !d().texto.lower().matches('.*(caralh|bucet|arrombad|vagabund|desgraca|xoxota|punheta|siririca|piroca|cuzao|porra|merda|puta|viado|fdp|pqp|bosta|corno).*')
          && d().em == request.time;
        allow delete: if request.auth != null && request.time > s().criada + duration.value(1, 'h');
      }

      // voto: um por jogador e por rodada, em outra pessoa da rodada
      match /votos/{id} {
        function s() { return get(/databases/$(database)/documents/infiltrado/$(codigo)).data; }
        function d() { return request.resource.data; }
        allow read: if true;
        allow create: if request.auth != null && s().status == 'votacao'
          && request.auth.uid in s().ordem
          && id == string(s().rodada) + '-' + request.auth.uid
          && d().keys().hasOnly(['rodada', 'alvo', 'em'])
          && d().rodada == s().rodada && d().alvo in s().ordem && d().alvo != request.auth.uid
          && d().em == request.time;
        allow delete: if request.auth != null && request.time > s().criada + duration.value(1, 'h');
      }

      // chute do infiltrado pego (quem é o infiltrado cada celular confere pela semente)
      match /chutes/{id} {
        function s() { return get(/databases/$(database)/documents/infiltrado/$(codigo)).data; }
        function d() { return request.resource.data; }
        allow read: if true;
        allow create: if request.auth != null && s().status == 'chute'
          && request.auth.uid in s().ordem && id == string(s().rodada)
          && d().keys().hasOnly(['rodada', 'por', 'palavra', 'em'])
          && d().rodada == s().rodada && d().por == request.auth.uid
          && d().palavra is string && d().palavra.size() <= 30 && d().em == request.time;
        allow delete: if request.auth != null && request.time > s().criada + duration.value(1, 'h');
      }
    }
    // Blefe (tatame-online): 3 a 8 jogadores inventam respostas falsas e tentam achar a verdadeira.
    // O anfitrião passa as fases (ou qualquer jogador, se ele sumir por 2 minutos). Cada um só manda a própria resposta e o próprio voto.
    match /blefe/{codigo} {
      function sala() { return resource.data; }
      function nova() { return request.resource.data; }
      function mudou() { return nova().diff(sala()).affectedKeys(); }
      function vence() { return sala().criada + duration.value(1, 'h'); }
      function host() { return request.auth.uid == sala().host; }
      function jogador() { return exists(/databases/$(database)/documents/blefe/$(codigo)/jogadores/$(request.auth.uid)); }
      function criar() {
        return codigo.matches('[0-9]{4}')
          && nova().keys().hasOnly(['host', 'status', 'rodada', 'total', 'inicio', 'criada', 'ordem', 'perguntas', 'seed', 'revanche'])
          && nova().host == request.auth.uid && nova().status == 'espera' && nova().rodada == 0 && nova().total == 0
          && nova().inicio == request.time && nova().criada == request.time
          && nova().ordem == [] && nova().perguntas == [] && nova().revanche == null;
      }
      function comecar() {
        return host() && sala().status == 'espera'
          && mudou().hasOnly(['status', 'total', 'rodada', 'inicio', 'ordem', 'perguntas', 'seed'])
          && nova().status == 'escrever' && nova().rodada == 0 && nova().total in [3, 5, 7]
          && nova().inicio == request.time && nova().seed is int
          && nova().ordem is list && nova().ordem.size() >= 3 && nova().ordem.size() <= 8
          && nova().perguntas is list && nova().perguntas.size() == nova().total;
      }
      // escrever → votar → placar → escrever (próxima rodada) … → fim
      function fase() {
        return (host() || (jogador() && request.time > sala().inicio + duration.value(120, 's')))
          && request.time > sala().inicio + duration.value(2, 's') && nova().inicio == request.time
          && ((sala().status == 'escrever' && nova().status == 'votar' && mudou().hasOnly(['status', 'inicio']))
            || (sala().status == 'votar' && nova().status == 'placar' && mudou().hasOnly(['status', 'inicio']))
            || (sala().status == 'placar' && nova().status == 'fim' && sala().rodada == sala().total - 1 && mudou().hasOnly(['status', 'inicio']))
            || (sala().status == 'placar' && nova().status == 'escrever' && nova().rodada == sala().rodada + 1
              && nova().rodada < sala().total && mudou().hasOnly(['status', 'inicio', 'rodada'])));
      }
      function revanche() {
        return jogador() && sala().status == 'fim' && sala().revanche == null
          && mudou().hasOnly(['revanche']) && nova().revanche is string && nova().revanche.matches('[0-9]{4}');
      }

      allow get: if true;
      allow list: if request.query.limit <= 10 && resource.data.criada < request.time - duration.value(1, 'h');
      allow create: if request.auth != null && criar();
      allow update: if request.auth != null && request.time < vence() && nova().criada == sala().criada
        && nova().host == sala().host && (comecar() || fase() || revanche());
      allow delete: if request.auth != null && (request.time > vence() || (host() && sala().status == 'espera'));

      match /jogadores/{uid} {
        function s() { return get(/databases/$(database)/documents/blefe/$(codigo)).data; }
        function venceu() { return request.time > s().criada + duration.value(1, 'h'); }
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == uid && s().status == 'espera' && !venceu()
          && request.resource.data.keys().hasOnly(['nick', 'avatar', 'entrou', 'visto'])
          && nickOk(request.resource.data.nick)
          && request.resource.data.avatar is int && request.resource.data.avatar >= 0 && request.resource.data.avatar <= 15
          && request.resource.data.entrou == request.time && request.resource.data.visto == request.time;
        allow update: if request.auth != null && request.auth.uid == uid && !venceu()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visto'])
          && request.resource.data.visto == request.time;
        allow delete: if request.auth != null && (venceu()
          || (s().status == 'espera' && (request.auth.uid == uid || request.auth.uid == s().host)));
      }

      // resposta falsa: até 30 caracteres, sem palavrão, só na fase de escrever; id = rodada-uid
      match /respostas/{id} {
        function s() { return get(/databases/$(database)/documents/blefe/$(codigo)).data; }
        function d() { return request.resource.data; }
        allow read: if true;
        allow create: if request.auth != null && s().status == 'escrever' && request.auth.uid in s().ordem
          && id == string(s().rodada) + '-' + request.auth.uid
          && d().keys().hasOnly(['rodada', 'texto', 'em']) && d().rodada == s().rodada
          && d().texto is string && d().texto.matches('[\\p{L}\\p{N} ,.!?-]{1,30}')
          && !d().texto.lower().matches('.*(caralh|bucet|arrombad|vagabund|desgraca|xoxota|punheta|siririca|piroca|cuzao|porra|merda|puta|viado|fdp|pqp|bosta|corno).*')
          && d().em == request.time;
        allow delete: if request.auth != null && request.time > s().criada + duration.value(1, 'h');
      }

      // voto: na verdade ou na resposta de outra pessoa da sala
      match /votos/{id} {
        function s() { return get(/databases/$(database)/documents/blefe/$(codigo)).data; }
        function d() { return request.resource.data; }
        allow read: if true;
        allow create: if request.auth != null && s().status == 'votar' && request.auth.uid in s().ordem
          && id == string(s().rodada) + '-' + request.auth.uid
          && d().keys().hasOnly(['rodada', 'escolha', 'em']) && d().rodada == s().rodada
          && (d().escolha == 'verdade' || (d().escolha in s().ordem && d().escolha != request.auth.uid))
          && d().em == request.time;
        allow delete: if request.auth != null && request.time > s().criada + duration.value(1, 'h');
      }
    }
  }
}
